@import "tailwindcss";

:root {
  --background: #071018;
  --background-secondary: #09151d;
  --background-elevated: #0d1d27;
  --background-warm: #181816;
  --foreground: #f1eee8;
  --muted: #a9b0b5;
  --gold: #b89a67;
  --gold-light: #ceb482;
  --steel: #718795;
  --border: rgba(208, 189, 137, 0.24);
  --border-strong: rgba(220, 228, 231, 0.14);
  --panel: rgba(10, 25, 36, 0.82);
  --panel-warm: rgba(15, 25, 32, 0.9);
  --red-indicator: #9b5b53;
  --shadow: 0 34px 100px rgba(0, 0, 0, 0.36);
}

@theme inline {
  --color-background: var(--background);
  --color-background-secondary: var(--background-secondary);
  --color-background-warm: var(--background-warm);
  --color-foreground: var(--foreground);
  --color-muted: var(--muted);
  --color-gold: var(--gold);
  --color-gold-light: var(--gold-light);
  --color-border: var(--border);
  --color-border-strong: var(--border-strong);
  --color-red-indicator: var(--red-indicator);
  --font-sans: var(--font-body);
  --font-mono: var(--font-mono);
}

* {
  box-sizing: border-box;
}

html {
  background:
    radial-gradient(circle at 72% 0%, rgba(50, 76, 91, 0.32), transparent 34%),
    linear-gradient(180deg, #091620 0%, #071018 38%, #08131b 100%);
}

body {
  min-height: 100vh;
  background: transparent;
  color: var(--foreground);
  font-family: var(--font-body), sans-serif;
  text-rendering: optimizeLegibility;
}

::selection {
  background: rgba(184, 154, 103, 0.26);
  color: var(--foreground);
}

a,
button,
input,
select,
textarea {
  transition:
    color 180ms ease,
    background-color 180ms ease,
    border-color 180ms ease,
    transform 180ms ease,
    opacity 180ms ease;
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 2px solid rgba(206, 180, 130, 0.9);
  outline-offset: 3px;
}

.site-shell {
  position: relative;
  isolation: isolate;
}

.section-shell {
  position: relative;
  width: min(100%, 1440px);
  margin-inline: auto;
  padding-inline: clamp(1.25rem, 3vw, 2.5rem);
}

.section-spacing {
  padding-block: clamp(4.5rem, 9vw, 8rem);
}

.section-rule {
  position: relative;
}

.section-rule::before {
  content: "";
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: 1px;
  background: linear-gradient(90deg, rgba(206, 180, 130, 0.7), transparent 92%);
  opacity: 0.55;
}

.section-title {
  font-family: var(--font-editorial), serif;
  font-size: clamp(3rem, 4.8vw, 4.9rem);
  font-weight: 500;
  line-height: 0.92;
  letter-spacing: -0.03em;
  text-wrap: balance;
}

.hero-title {
  text-wrap: balance;
}

.hero-title-serif {
  font-family: var(--font-editorial), serif;
  font-size: clamp(4.2rem, 7.3vw, 7.8rem);
  font-weight: 500;
  line-height: 0.82;
  letter-spacing: -0.045em;
}

.hero-title-sans {
  font-family: var(--font-display), sans-serif;
  font-size: clamp(3.9rem, 7vw, 7.5rem);
  font-weight: 600;
  line-height: 0.82;
  letter-spacing: -0.025em;
  text-transform: uppercase;
}

.body-copy {
  color: color-mix(in srgb, var(--foreground) 78%, var(--muted));
  font-size: clamp(1rem, 1.4vw, 1.18rem);
  line-height: 1.72;
}

.technical-label {
  font-family: var(--font-mono), monospace;
  font-size: 0.7rem;
  letter-spacing: 0.24em;
  text-transform: uppercase;
  color: color-mix(in srgb, var(--foreground) 70%, var(--muted));
}

.technical-accent {
  color: var(--gold-light);
}

.hero-surface {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 78% 30%, rgba(64, 91, 106, 0.18), transparent 26%),
    linear-gradient(135deg, #071018, #09151d 58%, #071018);
}

.hero-surface::before {
  content: "";
  position: absolute;
  top: -30%;
  right: 18%;
  width: 1px;
  height: 150%;
  background: linear-gradient(180deg, transparent, rgba(208, 189, 137, 0.32), transparent);
  transform: rotate(24deg);
  transform-origin: center;
}

.hero-surface::after {
  content: "";
  position: absolute;
  inset: auto -12% -48% auto;
  width: 62rem;
  height: 62rem;
  border: 1px solid rgba(113, 135, 149, 0.12);
  border-radius: 50%;
}

.brand-mark {
  clip-path: polygon(0 0, 84% 0, 100% 16%, 100% 100%, 0 100%);
}

.hero-bearing-row {
  background: rgba(255, 255, 255, 0.018);
}

.portrait-frame {
  background: linear-gradient(145deg, #102532, #091923 58%, #071018);
}

.portrait-atmosphere {
  background:
    radial-gradient(circle at 56% 24%, rgba(241, 238, 232, 0.12), transparent 20%),
    linear-gradient(135deg, rgba(113, 135, 149, 0.16), transparent 45%);
}

.portrait-grain {
  opacity: 0.16;
  background-image:
    radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.16) 0 0.5px, transparent 0.8px),
    radial-gradient(circle at 70% 62%, rgba(255, 255, 255, 0.11) 0 0.5px, transparent 0.8px);
  background-size: 5px 5px, 7px 7px;
  mix-blend-mode: soft-light;
}

.portrait-head,
.portrait-shoulders {
  background: linear-gradient(145deg, rgba(30, 49, 60, 0.94), rgba(9, 24, 34, 0.98));
  box-shadow: inset -20px 0 40px rgba(4, 13, 20, 0.34);
}

.operational-frame {
  background: #0a1720;
}

.operational-light {
  background:
    linear-gradient(112deg, transparent 30%, rgba(126, 151, 164, 0.14) 30.2%, transparent 60%),
    radial-gradient(circle at 72% 18%, rgba(184, 154, 103, 0.14), transparent 18%),
    linear-gradient(180deg, #112733, #091721 72%, #071018);
}

.bearing-mark {
  position: relative;
  overflow: hidden;
}

.bearing-geometry {
  position: absolute;
  inset: 0 0 0 auto;
  width: min(58%, 14rem);
  opacity: 0.62;
}

.bearing-arc {
  position: absolute;
  border: 1px solid rgba(206, 180, 130, 0.2);
  border-radius: 50%;
}

.bearing-arc-outer {
  width: 13rem;
  height: 13rem;
  right: -4.2rem;
  top: -2.4rem;
}

.bearing-arc-inner {
  width: 8rem;
  height: 8rem;
  right: -1.7rem;
  top: 0.2rem;
}

.bearing-needle {
  position: absolute;
  right: 3.1rem;
  top: 0;
  width: 1px;
  height: 9rem;
  background: linear-gradient(180deg, var(--gold-light), transparent);
  transform: rotate(28deg);
  transform-origin: top;
}

.bearing-center {
  position: absolute;
  right: 2.75rem;
  top: 3.5rem;
  width: 0.7rem;
  height: 0.7rem;
  border: 1px solid rgba(206, 180, 130, 0.6);
  border-radius: 50%;
}

.executive-panel {
  background: linear-gradient(145deg, rgba(13, 31, 43, 0.94), rgba(7, 18, 27, 0.98));
  border: 1px solid rgba(220, 228, 231, 0.12);
  box-shadow: var(--shadow);
  clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 20px, 100% 100%, 0 100%);
}

.executive-panel::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 2px;
  background: linear-gradient(90deg, var(--gold-light), transparent 72%);
}

.service-surface {
  background:
    radial-gradient(circle at 88% 22%, rgba(184, 154, 103, 0.05), transparent 26%),
    linear-gradient(180deg, #111817, #0c1518 82%, #09151d);
}

.capabilities-surface {
  background:
    radial-gradient(circle at 8% 42%, rgba(113, 135, 149, 0.09), transparent 26%),
    linear-gradient(180deg, #071018, #09151e);
}

.capabilities-surface::before {
  content: "";
  position: absolute;
  inset: 0 0 auto;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(206, 180, 130, 0.55), transparent);
}

.capability-row {
  isolation: isolate;
  transition:
    background-color 350ms ease,
    padding-inline 350ms ease;
}

.capability-row::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(90deg, rgba(184, 154, 103, 0.07), rgba(255, 255, 255, 0.018) 56%, transparent);
  opacity: 0;
  transition: opacity 350ms ease;
}

.capability-row:hover::before {
  opacity: 1;
}

.capability-row:hover .capability-row-accent {
  box-shadow: 0 0 24px rgba(206, 180, 130, 0.28);
}

@media (min-width: 1024px) {
  .capability-row:hover {
    padding-inline: 1.25rem;
  }
}

.ambient-panel {
  background: linear-gradient(180deg, rgba(17, 30, 40, 0.82), rgba(14, 25, 34, 0.72));
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: var(--shadow);
  backdrop-filter: blur(16px);
}

.warm-panel {
  background:
    linear-gradient(180deg, rgba(26, 25, 23, 0.92), rgba(18, 17, 16, 0.96)),
    radial-gradient(circle at top right, rgba(184, 154, 103, 0.08), transparent 22%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  box-shadow: var(--shadow);
}

.experience-surface {
  background: linear-gradient(180deg, #0d1d27, #09151d 88%);
}

.experience-spread {
  padding-block: clamp(4.5rem, 6.5vw, 6.75rem);
}

.experience-image img {
  filter: saturate(0.72) contrast(1.04) brightness(0.82);
  transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
}

.experience-image:hover img {
  transform: scale(1.018);
}

.experience-image::after {
  content: "";
  position: absolute;
  inset: 0 auto 0 0;
  width: 2px;
  background: linear-gradient(180deg, var(--gold-light), transparent 72%);
  opacity: 0.68;
}

.experience-grain {
  opacity: 0.1;
  background-image:
    radial-gradient(circle at 18% 26%, rgba(255, 255, 255, 0.2) 0 0.5px, transparent 0.8px),
    radial-gradient(circle at 72% 64%, rgba(255, 255, 255, 0.14) 0 0.5px, transparent 0.8px);
  background-size: 5px 5px, 7px 7px;
  mix-blend-mode: soft-light;
}

.experience-corner {
  position: absolute;
  width: 2.5rem;
  height: 2.5rem;
  opacity: 0.62;
}

.experience-corner-tl {
  top: 1rem;
  left: 1rem;
  border-top: 1px solid var(--gold-light);
  border-left: 1px solid var(--gold-light);
}

.experience-corner-br {
  right: 1rem;
  bottom: 1rem;
  border-right: 1px solid var(--gold-light);
  border-bottom: 1px solid var(--gold-light);
}

.experience-entry {
  min-height: 33.333%;
}

.principles-surface {
  background:
    radial-gradient(circle at 10% 90%, rgba(184, 163, 109, 0.065), transparent 26%),
    #071018;
}

.thin-rule {
  height: 1px;
  width: 100%;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.14), rgba(184, 154, 103, 0.32), rgba(255, 255, 255, 0.06));
}

.contact-panel {
  background:
    linear-gradient(180deg, rgba(24, 24, 22, 0.97), rgba(13, 19, 21, 0.99)),
    radial-gradient(circle at 20% 0%, rgba(184, 154, 103, 0.08), transparent 24%);
  border-top: 1px solid rgba(208, 189, 137, 0.28);
}

.field-shell {
  border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  background: transparent;
}

.field-shell:hover {
  border-color: rgba(208, 189, 137, 0.34);
}

.field-input {
  width: 100%;
  border: none;
  background: transparent;
  color: var(--foreground);
  padding: 0.9rem 0;
  font-size: 1rem;
  line-height: 1.5;
}

.field-input::placeholder {
  color: rgba(169, 176, 181, 0.8);
}

.field-input:focus {
  outline: none;
}

.balanced-text {
  text-wrap: balance;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
  }
}

/* Experience editorial redesign — intentionally self-contained */
.experience-intro-grid {
  display: grid;
  gap: 2rem;
  align-items: end;
}

.experience-statement-wrap {
  max-width: 48rem;
}

.experience-heading {
  max-width: 11ch;
  font-size: clamp(3.5rem, 5.7vw, 6.2rem);
  line-height: 0.9;
  letter-spacing: -0.04em;
  text-wrap: balance;
}

.experience-main-grid {
  display: grid;
  margin-top: clamp(3rem, 5vw, 5.5rem);
  border-top: 1px solid rgba(255,255,255,.11);
  border-bottom: 1px solid rgba(255,255,255,.11);
}

.experience-visual {
  position: relative;
  isolation: isolate;
  min-height: 36rem;
  overflow: hidden;
  background-image: url('/experience-aerospace.jpg');
  background-size: cover;
  background-position: center center;
  border-left: 1px solid rgba(255,255,255,.10);
  border-right: 1px solid rgba(255,255,255,.10);
}

.experience-visual::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(circle at 72% 30%, rgba(184,154,103,.13), transparent 28%),
    linear-gradient(105deg, rgba(4,12,18,.28), rgba(4,12,18,.04) 50%, rgba(4,12,18,.2));
}

.experience-visual-shade {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(7,16,24,.12), rgba(7,16,24,.16) 45%, rgba(7,16,24,.94) 100%),
    linear-gradient(90deg, rgba(7,16,24,.48), transparent 54%);
  z-index: 1;
}

.experience-visual-top,
.experience-visual-bottom,
.experience-bearing-orbit,
.experience-corner,
.experience-grain {
  z-index: 2;
}

.experience-visual-top {
  position: absolute;
  inset: 2rem 2rem auto;
  display: flex;
  justify-content: space-between;
  gap: 2rem;
}

.experience-visual-kicker,
.experience-frame-id,
.experience-visual-meta {
  margin-top: .75rem;
  font-family: var(--font-mono), monospace;
  font-size: .58rem;
  line-height: 1.6;
  letter-spacing: .19em;
  text-transform: uppercase;
  color: rgba(241,238,232,.52);
}

.experience-frame-id { margin-top: 0; color: rgba(241,238,232,.42); }

.experience-visual-bottom {
  position: absolute;
  left: 2rem;
  right: 2rem;
  bottom: 2rem;
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid rgba(241,238,232,.25);
}

.experience-visual-caption {
  max-width: 30rem;
  font-family: var(--font-editorial), serif;
  font-size: clamp(1.65rem, 2.2vw, 2.5rem);
  line-height: 1.03;
  letter-spacing: -.025em;
  color: var(--foreground);
}

.experience-bearing-readout {
  min-width: 8rem;
  text-align: right;
  font-family: var(--font-mono), monospace;
  text-transform: uppercase;
}
.experience-bearing-readout span {
  display: block;
  font-size: 2rem;
  letter-spacing: .06em;
  color: var(--gold-light);
}
.experience-bearing-readout small {
  display: block;
  margin-top: .35rem;
  font-size: .54rem;
  letter-spacing: .18em;
  color: rgba(241,238,232,.48);
}

.experience-bearing-orbit {
  position: absolute;
  width: 22rem;
  height: 22rem;
  right: -6rem;
  top: 6rem;
  opacity: .5;
}
.experience-orbit-one,
.experience-orbit-two {
  position: absolute;
  border: 1px solid rgba(206,180,130,.25);
  border-radius: 999px;
}
.experience-orbit-one { inset: 0; }
.experience-orbit-two { inset: 4rem; }
.experience-orbit-line {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 15rem;
  height: 1px;
  transform: rotate(-34deg);
  transform-origin: left center;
  background: linear-gradient(90deg, rgba(206,180,130,.5), transparent);
}

.experience-details {
  background: linear-gradient(180deg, rgba(10,24,33,.88), rgba(7,18,27,.96));
  border-right: 1px solid rgba(255,255,255,.10);
}

.experience-details-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 5.5rem;
  padding: 1.4rem 2rem;
  border-bottom: 1px solid rgba(255,255,255,.1);
}
.experience-details-count {
  font-family: var(--font-editorial), serif;
  font-size: 2.2rem;
  color: rgba(206,180,130,.72);
}

.experience-entry {
  min-height: 0;
  padding: clamp(2rem, 3vw, 3rem) 2rem;
  border-bottom: 1px solid rgba(255,255,255,.1);
}
.experience-entry:last-child { border-bottom: 0; }
.experience-entry-index {
  display: flex;
  align-items: center;
  gap: 1rem;
  font-family: var(--font-mono), monospace;
  font-size: .65rem;
  letter-spacing: .22em;
  color: var(--gold-light);
}
.experience-entry-rule {
  height: 1px;
  flex: 1;
  background: linear-gradient(90deg, rgba(206,180,130,.38), transparent);
}
.experience-entry h3 {
  max-width: 19ch;
  margin-top: 1.5rem;
  font-family: var(--font-display), sans-serif;
  font-size: clamp(1.55rem, 2vw, 2rem);
  font-weight: 600;
  line-height: .98;
  letter-spacing: -.015em;
  text-transform: uppercase;
  color: var(--foreground);
}
.experience-entry p {
  max-width: 35rem;
  margin-top: 1rem;
  font-size: clamp(.98rem, 1.2vw, 1.08rem);
  line-height: 1.72;
  color: color-mix(in srgb, var(--foreground) 76%, var(--muted));
}

.experience-footer-strip {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  min-height: 5rem;
  padding: 1.3rem 1.6rem;
  border: 1px solid rgba(255,255,255,.10);
  border-top: 0;
  font-family: var(--font-mono), monospace;
  font-size: .62rem;
  letter-spacing: .19em;
  text-transform: uppercase;
  color: rgba(241,238,232,.55);
}
.experience-footer-strip i { color: var(--gold-light); font-style: normal; }
.experience-footer-strip strong {
  margin-left: auto;
  font-weight: 400;
  color: rgba(241,238,232,.7);
}

@media (min-width: 1024px) {
  .experience-intro-grid {
    grid-template-columns: minmax(250px,.62fr) minmax(0,1.38fr);
    gap: 4rem;
  }
  .experience-main-grid {
    grid-template-columns: minmax(0,1.22fr) minmax(390px,.78fr);
  }
  .experience-visual { min-height: 47rem; }
}

@media (max-width: 1023px) {
  .experience-visual { min-height: 31rem; }
  .experience-footer-strip { flex-wrap: wrap; }
  .experience-footer-strip strong { width: 100%; margin-left: 0; }
}

@media (max-width: 640px) {
  .experience-heading { font-size: clamp(3.25rem, 14vw, 4.6rem); }
  .experience-visual { min-height: 29rem; background-position: 64% center; }
  .experience-visual-top { inset: 1.25rem 1.25rem auto; }
  .experience-visual-bottom { left: 1.25rem; right: 1.25rem; bottom: 1.25rem; display: block; }
  .experience-bearing-readout { margin-top: 1.25rem; text-align: left; }
  .experience-details-header, .experience-entry { padding-left: 1.25rem; padding-right: 1.25rem; }
}

/* === PREMIUM LIGHTER PALETTE / NO BACKGROUND GRID v1 === */
:root {
  --background: #10212a;
  --background-secondary: #142a35;
  --background-elevated: #1a3440;
  --background-warm: #292825;
  --foreground: #f5f1e9;
  --muted: #bac3c6;
  --gold: #bfa36f;
  --gold-light: #d1ba8a;
  --steel: #8ea0aa;
  --border: rgba(209, 186, 138, 0.24);
  --border-strong: rgba(236, 240, 240, 0.14);
  --panel: rgba(22, 47, 59, 0.9);
  --panel-warm: rgba(36, 39, 39, 0.92);
  --shadow: 0 28px 72px rgba(2, 9, 12, 0.22);
}

html {
  background: #10212a !important;
}

body {
  background: #10212a !important;
}

/* Remove decorative grid / radar / technical background geometry. */
.hero-surface,
.service-surface,
.capabilities-surface,
.experience-surface,
.principles-surface,
.contact-panel,
.warm-panel,
.ambient-panel,
.executive-panel,
.operational-frame,
.operational-light,
.portrait-frame,
.portrait-atmosphere {
  background-image: none !important;
}

.hero-surface {
  background: linear-gradient(180deg, #132a35 0%, #10242e 55%, #10212a 100%) !important;
}

.service-surface {
  background: #172b32 !important;
}

.capabilities-surface {
  background: #122832 !important;
}

.experience-surface {
  background: #19313a !important;
}

.principles-surface {
  background: #16272d !important;
}

.contact-panel {
  background: #242724 !important;
}

.warm-panel {
  background: #252824 !important;
}

.ambient-panel,
.executive-panel {
  background: #193440 !important;
}

.operational-frame,
.operational-light,
.portrait-frame,
.portrait-atmosphere {
  background: #19333e !important;
}

/* Remove all large decorative lines, circles and pseudo-grid ornamentation. */
.hero-surface::before,
.hero-surface::after,
.capabilities-surface::before,
.bearing-geometry,
.portrait-grain,
.experience-grain {
  display: none !important;
}

/* Keep section separators, but make them quieter and more editorial. */
.section-rule::before {
  background: rgba(209, 186, 138, 0.34) !important;
  opacity: 0.55 !important;
}

.thin-rule {
  background: rgba(235, 239, 238, 0.13) !important;
}

.hero-bearing-row {
  background: rgba(255,255,255,0.025) !important;
}

.capability-row::before {
  background: rgba(255,255,255,0.025) !important;
}

.capability-row:hover::before {
  opacity: 1 !important;
}

/* Softer image treatment so the whole site is not crushed into near-black. */
.experience-image img {
  filter: saturate(0.78) contrast(0.98) brightness(0.94) !important;
}

/* Lift muted copy slightly for a lighter, more premium reading experience. */
.body-copy {
  color: color-mix(in srgb, var(--foreground) 82%, var(--muted)) !important;
}

.technical-label {
  color: color-mix(in srgb, var(--foreground) 68%, var(--muted)) !important;
}

